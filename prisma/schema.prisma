generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  engineType ="binary"
}
datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  adminLogs     AdminLog[]
  notifications Notification[]
  profile       UserProfile?
  roles         UserRole[]
  enrollments   Enrollment[]
  payments      Payment[]
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String?
  lastName  String?
  phone     String?
  gender    String?
  dob       DateTime?
  address   String?
  bio       String?
  user      User      @relation(fields: [userId], references: [id])
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AdminLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  targetTable String
  targetId    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  admin       User     @relation(fields: [adminId], references: [id])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String?  @unique
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id              String       @id @default(uuid())
  categoryId      String
  title           String
  slug            String?      @unique
  briefDefinition String
  prerequisite    String?
  keyAreas        String[]
  outcomes        String[]
  jobRoles        String[]
  industries      String[]
  duration        String?
  cost            Int?
  paid            Boolean
  thumbnail       String?
  status          CourseStatus @default(draft)
  level           CourseLevel
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        Category     @relation(fields: [categoryId], references: [id])
  enrollments   Enrollment[]
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Enrollment {
  id           String           @id @default(uuid())
  userId       String
  courseId     String
  status       EnrollmentStatus @default(active)
  
  // Duration Tracking
  enrolledAt   DateTime         @default(now())
  expiresAt    DateTime?        // Null for lifetime access, or set a date
  lastAccessed DateTime         @updatedAt
  progress     Float            @default(0) // 0 to 100 percentage
  
  user         User             @relation(fields: [userId], references: [id])
  course       Course           @relation(fields: [courseId], references: [id])
  payment      Payment?         // Link to the payment that created this

  // CRITICAL: Prevents double enrollment for the same course
  @@unique([userId, courseId])
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  enrollmentId     String?       @unique // Optional: Link to enrollment after success
  amount           Int
  currency         String        @default("NGN")
  status           PaymentStatus @default(pending)
  transactionRef   String        @unique // tx_ref from Flutterwave
  flutterwaveId    String?       @unique // flw_id from Flutterwave response
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  enrollment       Enrollment?   @relation(fields: [enrollmentId], references: [id])
}



enum CourseStatus {
  draft
  published
  archived
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}


enum EnrollmentStatus {
  active
  completed
  expired
  suspended
}

enum PaymentStatus {
  pending
  successful
  failed
}